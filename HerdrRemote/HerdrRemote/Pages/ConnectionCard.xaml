<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="HerdrRemote.Pages.ConnectionCard">
    <!-- Connection status card with a state-colored glyph, title, optional body, and up to two buttons.
         Show sets the content and places one button beside the text or two below it. -->
    <Border x:Name="Card">
        <Grid Style="{StaticResource Card.Grid}">
            <Label x:Name="Lbl_Glyph" Grid.RowSpan="2" Style="{StaticResource Card.Glyph}"/>
            <Label x:Name="Lbl_Title" Grid.Column="1" Style="{StaticResource Card.Title}"/>
            <Label x:Name="Lbl_Body" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card.Body}"/>
            <HorizontalStackLayout x:Name="Buttons" Style="{StaticResource Card.Buttons}"/>
        </Grid>
    </Border>
</ContentView>
