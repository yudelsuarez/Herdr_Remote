<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="HerdrRemote.Pages.FindBar">
    <!-- Terminal search overlay below the header: query, search icon, match count ("i / n" or "No matches"),
         previous, next, and close. Previous uses the inverted down glyph, as the D-pad does. Labels are set in code. -->
    <Grid Style="{StaticResource Find}">
        <Border Grid.Column="0" Style="{StaticResource Find.Field}">
            <Grid Style="{StaticResource Find.Inner}" ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0" Text="&#xE906;" Style="{StaticResource Find.Glyph}" AutomationProperties.IsInAccessibleTree="False"/>
                <Entry x:Name="Field" AutomationId="TerminalFind" Grid.Column="1" Style="{StaticResource Find.Entry}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                       TextChanged="Field_TextChanged"/>
                <Label x:Name="Lbl_Count" Grid.Column="2" Style="{StaticResource Find.Count}" MaximumWidthRequest="120" MaxLines="1" LineBreakMode="TailTruncation"/>
            </Grid>
        </Border>
        <Button x:Name="Btn_Previous" Grid.Column="1" Text="&#xE909;" Rotation="180" Style="{StaticResource Find.Key}" Clicked="Previous_Clicked"/>
        <Button x:Name="Btn_Next" Grid.Column="2" Text="&#xE909;" Style="{StaticResource Find.Key}" Clicked="Next_Clicked"/>
        <Button x:Name="Btn_Close" Grid.Column="3" Text="&#xE91D;" Style="{StaticResource Find.Key}" Clicked="Close_Clicked"/>
    </Grid>
</ContentView>
