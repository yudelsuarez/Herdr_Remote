<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<!-- App.SetSystemBarIcons depends on view-controller-based status bar appearance. -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- iOS asks for consent before the first connection to a local address and quotes this sentence.
	     Spanish lives in Resources/es.lproj/InfoPlist.strings. No NSBonjourServices: the app does no discovery. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Remote Shell connects to herdr on your machine over your Wi-Fi. Without this, the app cannot show your spaces.</string>
	<!-- iOS asks before the first "Save to photos" of an agent's image and quotes this sentence (add only, no reading). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Remote Shell saves the images your agents show to your photos when you tap Save to photos.</string>
	<!-- iOS asks before the Attach key's first Camera (MediaPicker.CapturePhotoAsync) and quotes this sentence. Photos (PHPicker) and Files need none. -->
	<key>NSCameraUsageDescription</key>
	<string>Remote Shell uses the camera when you tap Camera to send a photo to your agent.</string>
	<!-- iOS asks before the first dictation (the key bar's mic key) and quotes these sentences. Dictation listens only while the draft listens. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Remote Shell listens only while you dictate a message for your agent.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Remote Shell turns your dictation into text on this device.</string>
	<!-- Export compliance: SSH uses only standard, published algorithms (via SSH.NET and BouncyCastle) and the App Store
	     listing excludes France, so no export documentation is required. This pre-answers App Store Connect's questionnaire.
	     Before adding France to the App Store availability, a French encryption declaration is required. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>
