<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <!-- SecureStorage (Keychain) needs an app keychain group; without it every keychain call fails
             with -34018 and the API keys are never stored. The provisioning profile must grant it. -->
        <key>keychain-access-groups</key>
        <array>
            <string>$(AppIdentifierPrefix)com.yudelsuarez.remoteshell</string>
        </array>
    </dict>
</plist>
